---
import Base from '../layouts/Base.astro';
import PublicationRow from '../components/PublicationRow.astro';
import { publications } from '../lib/content';
---
<Base>
  <div class="wrap home-page">
    <section class="profile">
      <div>
        <h1>Jared Macshane</h1>
        <p class="affiliation">PhD Student in Computer Science<br /><a href="https://uci.edu/">University of California, Irvine</a></p>
        <div class="profile-links"><a href="mailto:jmacshan@uci.edu">Email</a><a href="/uploads/resume.pdf">CV</a><a href="https://github.com/Jared-Mac">GitHub</a><a href="https://www.linkedin.com/in/jared-macshane-733971b9">LinkedIn</a></div>
      </div>
      <img class="profile-photo" src="/images/jared.jpg" alt="Jared Macshane" width="960" height="720" fetchpriority="high" />
    </section>
    <div class="bio-text">
      <p>I am a PhD student in the Distributed Systems Middleware Group at UC Irvine. My research focuses on distributed machine-learning systems for resource-constrained edge environments, particularly task-informed neural compression and progressive inference.</p>
      <p>I study how sensing platforms can preserve task accuracy while reducing communication and computation costs, with applications in environmental monitoring and disaster resilience. Previously, I worked on geospatial machine learning at CSU San Marcos and computer vision for wildlife conservation at the San Diego Zoo Wildlife Alliance.</p>
    </div>
    <section class="section">
      <h2>Research interests</h2>
      <p>Edge and split computing; neural compression; progressive inference; digital twins; computer vision.</p>
    </section>
    <section class="section">
      <h2>Current research</h2>
      <p><a href="/project/mantis/">MANTIS</a> develops task-informed neural compression for UAV split inference. <a href="/project/shield/">SHIELD</a> connects edge sensing, simulation, and visualization in community-scale digital twins for disaster resilience.</p>
      <p class="section-link"><a href="/projects/">Research projects</a></p>
    </section>
    <section class="section">
      <h2>Selected publications and manuscripts</h2>
      <div>{publications.filter(p => p.featured).map(entry => <PublicationRow entry={entry} />)}</div>
      <p class="section-link"><a href="/publications/">Complete publication list</a></p>
    </section>
  </div>
</Base>
