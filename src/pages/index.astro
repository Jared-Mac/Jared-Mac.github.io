---
import Base from '../layouts/Base.astro';
import LightTable from '../components/LightTable.astro';
import PublicationRow from '../components/PublicationRow.astro';
import { publications, projects } from '../lib/content';
---
<Base>
  <div class="wrap home">
    <LightTable
      projects={projects}
      current={['mantis', 'shield']}
      lead={{ scene: 'hero', caption: 'From the field to the edge', label: 'A drone over farmland at golden hour sends shrinking packets of compressed data to an edge-computing mast.' }}
    >
      <header class="statement-block">
        <h1 class="statement"><span class="statement-name">Jared Macshane</span> builds machine-learning systems for places where bandwidth, computation, and time are <em>limited.</em></h1>
        <p class="statement-meta">PhD student · Distributed Systems Middleware Group · UC Irvine</p>
        <p class="statement-links"><a href="mailto:jmacshan@uci.edu">Email</a><a href="/uploads/resume.pdf">CV</a><a href="https://github.com/Jared-Mac">GitHub</a><a href="https://www.linkedin.com/in/jared-macshane-733971b9">LinkedIn</a></p>
      </header>
      <h2 class="label-heading" id="research">Research</h2>
    </LightTable>

    <section class="quiet-section" aria-labelledby="writing-title">
      <div class="quiet-heading"><h2 class="label-heading" id="writing-title">Selected publications</h2><a class="section-link" href="/publications/">All publications →</a></div>
      <div>{publications.filter(p => p.featured).map(entry => <PublicationRow entry={entry} />)}</div>
    </section>

    <section class="quiet-section about" aria-labelledby="about-title">
      <div class="quiet-heading"><h2 class="label-heading" id="about-title">About</h2><a class="section-link" href="/experience/">Experience →</a></div>
      <div class="about-body">
        <figure class="portrait"><div class="portrait-image"><canvas data-riso-photo="#portrait-photo" data-crop="170 200 440 520" aria-hidden="true"></canvas><img id="portrait-photo" src="/images/jared.jpg" alt="Jared Macshane" width="960" height="720" loading="lazy" /></div></figure>
        <div class="bio-text"><p>I am a PhD student in the Distributed Systems Middleware Group at UC Irvine. My research focuses on distributed machine-learning systems for resource-constrained edge environments, particularly task-informed neural compression and progressive inference.</p><p>I study how sensing platforms can preserve task accuracy while reducing communication and computation costs, with applications in environmental monitoring and disaster resilience. Previously, I worked on geospatial machine learning at CSU San Marcos and computer vision for wildlife conservation at the San Diego Zoo Wildlife Alliance.</p></div>
      </div>
    </section>
  </div>
</Base>
