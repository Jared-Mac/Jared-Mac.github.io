---
import Base from '../../layouts/Base.astro';
import { projects, publications, projectKicker, projectImage, markdown, slugify } from '../../lib/content';
import type { Entry } from '../../lib/content';
export function getStaticPaths() { return projects.map(project => ({ params: { slug: project.slug }, props: { project } })); }
interface Props { project: Entry; }
const { project } = Astro.props;
const related = publications.filter(p => p.url_project === project.path);
const next = projects[(projects.findIndex(p => p.slug === project.slug) + 1) % projects.length];
---
<Base title={`${project.title} — Jared Macshane`} description={project.summary} image={projectImage(project.slug)}>
  <article class="wrap detail-page">
    <header class="page-intro"><a class="back-link" href="/projects/">← All research</a><p class="eyebrow">{projectKicker[project.slug]}</p><h1>{project.title}</h1><p>{project.summary}</p><div class="tag-list">{project.tags.map(tag => <a href={`/tags/${slugify(tag)}/`}>{tag}</a>)}</div></header>
    <div class="detail-grid"><aside class="detail-aside"><span class="eyebrow">Research project</span><p>{project.year}</p>{project.slug === 'mantis' && <p class="review-label">Manuscript under review</p>}{related.length > 0 && <div><span class="eyebrow">Related publications</span>{related.map(p => <a class="aside-link" href={p.path}>{p.title} ↗</a>)}</div>}</aside><div class="prose" set:html={markdown(project.body)} /></div>
    {project.slug === 'mantis' && <section class="supporting-figures"><div class="section-heading"><h2>A closer <em>look.</em></h2></div><figure><img src="/uploads/mantis/channel-usage-bpp.png" alt="Task-conditioned latent channel usage across bitrate operating points" loading="lazy" /><figcaption>Task conditioning changes how the compressed representation allocates bitrate.</figcaption></figure><figure><img src="/uploads/mantis/a10-fp16-baselines.png" alt="MANTIS evaluation against baseline methods on A10 hardware with FP16 precision" loading="lazy" /><figcaption>Baseline comparisons from the MANTIS evaluation.</figcaption></figure></section>}
    <a class="next-project" href={next.path}><span class="eyebrow">Next project</span><h2>{next.title} <span aria-hidden="true">↗</span></h2></a>
  </article>
</Base>
