---
import Base from '../../layouts/Base.astro';
import { projects, publications, projectKicker, projectImage, projectFigure, markdown, slugify } from '../../lib/content';
import type { Entry } from '../../lib/content';
export function getStaticPaths() { return projects.map(project => ({ params: { slug: project.slug }, props: { project } })); }
interface Props { project: Entry; }
const { project } = Astro.props;
const related = publications.filter(p => p.url_project === project.path);
const next = projects[(projects.findIndex(p => p.slug === project.slug) + 1) % projects.length];
---
<Base title={`${project.title} — Jared Macshane`} description={project.summary} image={projectImage(project.slug)}>
  <article class="wrap detail-page">
    <header class="page-intro"><a class="back-link" href="/projects/">← All research</a><p class="eyebrow">{projectKicker[project.slug]}</p><h1>{project.title}</h1><p>{project.summary}</p><div class="tag-list">{project.tags.map(tag => <a href={`/tags/${slugify(tag)}/`}>{tag}</a>)}</div></header>
    <figure class="detail-figure"><div class="detail-cover"><canvas data-riso={project.slug} aria-hidden="true"></canvas></div><figcaption>{projectFigure[project.slug]}</figcaption></figure>
    {project.slug === 'trail-mapping' && <figure class="detail-figure steps-figure"><div class="steps-cover"><canvas data-riso="trail-steps" aria-hidden="true"></canvas></div><figcaption><ol><li><b>Grow.</b> Each fix is presented in turn; the nearest neuron and its neighbours within r adapt toward it, and a fix farther than GT = −2 ln SF from every neuron grows a new one.</li><li><b>Connect.</b> Each fix joins its two nearest neurons with an edge, which over-connects into false triangles (red).</li><li><b>Collapse and smooth.</b> Triangles contract to the mean of their neurons, then weights adapt again at 2r and r/2 with no growth.</li></ol></figcaption></figure>}
    <div class="detail-grid"><aside class="detail-aside"><span class="eyebrow">Research project</span><p>{project.year}</p>{related.filter(p => p.publication_status === 'forthcoming').map(p => <p class="review-label">{p.publication}</p>)}{related.length > 0 && <div><span class="eyebrow">Related publications</span>{related.map(p => <a class="aside-link" href={p.path}>{p.title}</a>)}</div>}</aside><div class="prose" set:html={markdown(project.body)} /></div>
    {project.slug === 'mantis' && <section class="supporting-figures"><div class="section-heading"><h2>Additional results</h2></div><figure><img src="/uploads/mantis/channel-usage-bpp.png" alt="Task-conditioned latent channel usage across bitrate operating points" loading="lazy" /><figcaption>Task conditioning changes how the compressed representation allocates bitrate.</figcaption></figure><figure><img src="/uploads/mantis/a10-fp16-baselines.png" alt="MANTIS evaluation against baseline methods on A10 hardware with FP16 precision" loading="lazy" /><figcaption>Baseline comparisons from the MANTIS evaluation.</figcaption></figure></section>}
    <a class="next-project" href={next.path}><span>{next.title}</span><span class="eyebrow">Next project →</span></a>
  </article>
</Base>
