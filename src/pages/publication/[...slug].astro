---
import Base from '../../layouts/Base.astro';
import { publications, authors, markdown, slugify } from '../../lib/content';
import type { Entry } from '../../lib/content';
export function getStaticPaths() { return publications.map(entry => ({ params: { slug: entry.slug }, props: { entry } })); }
interface Props { entry: Entry; }
const { entry } = Astro.props;
const citation = `${authors(entry)} (${entry.year}). ${entry.title}. ${(entry.publication ?? '').replaceAll('*', '')}.${entry.doi ? ` https://doi.org/${entry.doi}` : ''}`;
---
<Base title={`${entry.title} — Jared Macshane`} description={entry.summary} image={null}>
  <article class="wrap detail-page publication-detail">
    <header class="page-intro"><a class="back-link" href="/publications/">← All publications</a><p class="eyebrow">{entry.year} / {(entry.publication_short ?? '').replaceAll('*', '')}</p><h1>{entry.title}</h1><p class="detail-authors">{authors(entry)}</p><div class="tag-list">{entry.tags.map(tag => <a href={`/tags/${slugify(tag)}/`}>{tag}</a>)}</div></header>
    <div class="detail-grid"><aside class="detail-aside"><span class="eyebrow">{entry.publication_status === 'forthcoming' || entry.publication === 'Under Review' ? 'Publication status' : 'Published in'}</span><div set:html={markdown(entry.publication ?? '')} /><div class="detail-actions">{entry.url_pdf && <a class="button" href={entry.url_pdf}>Read paper</a>}{entry.doi && <a class="text-link" href={`https://doi.org/${entry.doi}`}>Publisher / DOI</a>}{entry.url_project && <a class="text-link" href={entry.url_project}>Project</a>}</div></aside><div class="prose"><h2>Abstract</h2><p>{entry.abstract}</p>{entry.body.trim() && <div set:html={markdown(entry.body)} />}<details class="citation"><summary>Citation</summary><p id="citation-text">{citation}</p><button type="button" class="copy-citation" data-citation={citation}>Copy citation</button><span id="copy-status" role="status" aria-live="polite"></span></details></div></div>
  </article>
</Base>
<script>
  const button = document.querySelector<HTMLButtonElement>('.copy-citation');
  button?.addEventListener('click', async () => {
    const status = document.querySelector('#copy-status')!;
    try {
      await navigator.clipboard.writeText(button.dataset.citation!);
      status.textContent = 'Copied to clipboard.';
    } catch {
      status.textContent = 'Select and copy the citation above.';
    }
  });
</script>
