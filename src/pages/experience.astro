---
import Base from '../layouts/Base.astro';
import { profile, experience, markdown } from '../lib/content';
interface Work { title: string; company: string; date_start: string; date_end?: string; description: string; }
interface Education { area: string; institution: string; date_start: string; date_end?: string; summary?: string; }
interface Award { title: string; awarder: string; date: string; summary: string; }
const work = experience.sections.find((s: { block: string }) => s.block === 'resume-experience').content.items as Work[];
const education = profile.data.education as Education[];
const awards = profile.data.awards as Award[];
const year = (value: string | Date) => new Date(value).getUTCFullYear().toString();
---
<Base title="Experience & education — Jared Macshane" description="Research experience, education, and awards of Jared Macshane, a computer science PhD student at UC Irvine.">
  <div class="wrap">
    <header class="page-intro"><h1>Experience and education</h1><p><a href="/uploads/resume.pdf">Download CV (PDF)</a></p></header>
    <section class="section resume-section"><div class="resume-heading"><h2>Research and industry experience</h2></div><div>{work.map(item => <article class="timeline-item"><p class="eyebrow">{year(item.date_start)} — {item.date_end ? year(item.date_end) : 'Present'}</p><h3>{item.title}</h3><p class="organization">{item.company}</p><div class="prose" set:html={markdown(item.description)} /></article>)}</div></section>
    <section class="section resume-section"><div class="resume-heading"><h2>Education</h2></div><div>{education.map(item => <article class="timeline-item"><p class="eyebrow">{year(item.date_start)} — {item.date_end ? year(item.date_end) : 'Present'}</p><h3>{item.area}</h3><p class="organization">{item.institution}</p>{item.summary && <p>{item.summary}</p>}</article>)}</div></section>
    <section class="section"><h2>Awards and fellowships</h2><div class="awards-grid">{awards.map(award => <article><span class="eyebrow">{year(award.date)} · {award.awarder}</span><h3>{award.title}</h3><p>{award.summary}</p></article>)}</div></section>
  </div>
</Base>
