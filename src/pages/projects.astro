---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../lib/content';
---
<Base title="Research & projects — Jared Macshane" description="Research in task-informed compression, edge intelligence, disaster-resilience digital twins, geospatial machine learning, and immersive science labs.">
  <div class="wrap">
    <header class="page-intro"><h1>Research</h1><p>My research focuses on distributed machine learning under constraints on bandwidth, computation, and latency. These projects span neural compression, environmental sensing, digital twins, and applied computer vision.</p></header>
    <section class="section" aria-label="Research projects"><div class="project-grid">{projects.map(project => <ProjectCard project={project} />)}</div></section>
  </div>
</Base>
