---
import Base from '../layouts/Base.astro';
import LightTable from '../components/LightTable.astro';
import { projects } from '../lib/content';
---
<Base title="Research & projects — Jared Macshane" description="Research in task-informed compression, edge intelligence, disaster-resilience digital twins, geospatial machine learning, and immersive science labs.">
  <div class="wrap research-page">
    <LightTable projects={projects} current={['mantis', 'shield']} summaries>
      <header class="statement-block">
        <h1 class="statement">Research</h1>
        <p class="statement-meta">Machine learning under constraints on bandwidth, computation, and time.</p>
      </header>
    </LightTable>
  </div>
</Base>
