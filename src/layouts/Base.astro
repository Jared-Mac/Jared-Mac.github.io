---
import '../styles/global.css';
interface Props { title?: string; description?: string; image?: string | null; canonicalPath?: string; noindex?: boolean; }
const {
  title = 'Jared Macshane — Computer Science, UC Irvine',
  description = 'Jared Macshane is a UC Irvine PhD student researching neural compression, split computing, and digital twins for disaster resilience.',
  image = '/images/jared.jpg',
  canonicalPath = Astro.url.pathname,
  noindex = false,
} = Astro.props;
const canonical = new URL(canonicalPath, Astro.site);
const socialImage = image ? new URL(image, Astro.site) : null;
const links = [['Research', '/projects/'], ['Publications', '/publications/'], ['Experience', '/experience/']];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="alternate" type="application/rss+xml" title="Jared Macshane — Research" href="/index.xml" />
    <meta name="theme-color" content="#F4EEE2" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=IBM+Plex+Mono:wght@400;600&display=swap" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Jared Macshane" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="registration" aria-hidden="true"></div>
    <header class="site-header wrap">
      <a class="wordmark" href="/" aria-label="Jared Macshane, home"><span class="mark" aria-hidden="true"></span>Jared Macshane</a>
      <nav aria-label="Main navigation">
        {links.map(([label, href]) => <a href={href} aria-current={canonicalPath.startsWith(href) || (href === '/projects/' && canonicalPath.startsWith('/project/')) || (href === '/publications/' && canonicalPath.startsWith('/publication/')) ? 'page' : undefined}>{label}</a>)}
        <a href="/uploads/resume.pdf">CV</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer wrap"><span>© {new Date().getFullYear()} Jared Macshane</span><a href="mailto:jmacshan@uci.edu">jmacshan@uci.edu</a></footer>
    <script>
      import { init } from '../scripts/riso';
      init();
    </script>
  </body>
</html>
